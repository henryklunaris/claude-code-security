{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prevent-force-push.py"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prevent-env-exfil.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prevent-delete.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.claude/settings.json)",
      "Edit(~/.claude/settings.json)",
      "Read(/.claude/settings.json)",
      "Edit(/.claude/settings.json)",
      "Read(/.claude/settings.local.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",

      "Read(/.mcp.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(/secrets/**)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_dsa*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",

      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Grep(**/secrets/**)",
      "Grep(~/.ssh/*)",
      "Grep(~/.aws/*)",
      "Grep(**/credentials*)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(mv .claude/settings.json *)",
      "Bash(mv .claude/settings.local.json *)",
      "Bash(mv .claude/hooks/* *)",
      "Bash(chmod .claude/hooks/* *)",
      "Bash(chmod * .claude/hooks/*)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(> /dev/*)",
      "Bash(shred *)",
      "Bash(unlink *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
